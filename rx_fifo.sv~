module rx_fifo(
    parameter FLIT_WIDTH = 512,
    parameter DEPTH      = 4,
    parameter ADDR_W     = $clog2(DEPTH)
)(
    input clk,
    input reset_n,

    // Incoming packet interface
    input tx_valid,
    input rx_pkt_valid,
    input [511:0]  rx_pkt_data,
    output logic rx_ready,

    // Packet receive status
    output logic [1:0] pkt_receive_sts,

    // Outgoing flit interface
	output logic   flit_out_valid,
    output logic [511:0]  flit_data_out,

    // FIFO status
    output logic fifo_full,
    output logic fifo_empty
);

    // Internal signals
    logic [511:0] fifo_mem [DEPTH];
    logic [ADDR_W:0] wr_ptr, rd_ptr;
    logic [ADDR_W:0] fifo_count;
    logic [ADDR_W:0] credit_outstanding;
    logic fifo_wr_en;
    logic fifo_rd_en;
    // Credit mechanism
   assign fifo_full  = (fifo_count == DEPTH);
    assign fifo_empty = (fifo_count == 0);
    assign rx_ready   = !fifo_full;

    assign fifo_wr_en = rx_pkt_valid && rx_ready;
    assign fifo_rd_en = !fifo_empty; 



    // PACKET RECEIVE STATUS 
    always_ff @(posedge clk or negedge reset_n) begin
        if (!reset_n) begin
            pkt_receive_sts <= 2'b00;           // DEFAULT
        end
        else begin
            pkt_receive_sts <= 2'b00;           // default first

            if (fifo_wr_en)
                pkt_receive_sts <= 2'b01;       // packet received
            else if (rx_pkt_valid && !rx_ready)
                pkt_receive_sts <= 2'b10;       // error
        end
    end
// RX_READY LOGIC
	//Track outstanding credits
    always_ff @(posedge clk or negedge reset_n) 
	begin
         if (!reset_n) begin
        credit_outstanding <= 1'b0;
         end
    else
	begin
        // TX consumed a credit (flit accepted by RX)
        if (flit_valid && flit_pop)
            credit_outstanding <= credit_outstanding - 1'b1;

        // RX granted a new credit
        if (rx_ready)
            credit_outstanding <= credit_outstanding + 1'b1;
    end
   end

// RX is ready if guaranteed FIFO space exists
assign rx_ready = ((FIFO_DEPTH - fifo_count) > credit_outstanding);

    // FIFO WRITE LOGIC
    always_ff @(posedge clk or negedge reset_n) begin
        if (!reset_n) begin
            wr_ptr <= 1'b0;
        end
        else if (fifo_wr_en) begin
            fifo_mem[wr_ptr[ADDR_W-1:0]] <= rx_pkt_data;
            wr_ptr <= wr_ptr + 1'b1;
        end
    end
   
    // FIFO READ LOGIC
    always_ff @(posedge clk or negedge reset_n) begin
        if (!reset_n) begin
          rd_ptr         <= 1'b0;
          flit_data_out  <= 1'b0;
          flit_out_valid <= 1'b0;
         end
    else if (!fifo_empty) begin
        // Read enable when FIFO has data
        flit_data_out  <= fifo_mem[rd_ptr[ADDR_W-1:0]];
        flit_out_valid <= 1'b1;
        rd_ptr         <= rd_ptr + 1'b1;
    end
    else begin
        flit_out_valid <= 1'b0;
    end
end

    // FIFO COUNT (CREDIT TRACKING)
    always_ff @(posedge clk or negedge reset_n) begin
        if (!reset_n) begin
            fifo_count <= '0;
        end
        else begin
            case ({fifo_wr_en, fifo_rd_en})
                2'b10: fifo_count <= fifo_count + 1'b1;
                2'b01: fifo_count <= fifo_count - 1'b1;
                default: fifo_count <= fifo_count;
            endcase
        end
    end
    // OUTPUT REGISTER
    always_ff @(posedge clk or negedge reset_n) begin
        if (!reset_n) begin
            flit_data_out  <= 1'b0;
            flit_out_valid <= 1'b0;
        end
        else if (fifo_rd_en) begin
            flit_data_out  <= fifo_mem[rd_ptr[ADDR_W-1:0]];
            flit_out_valid <= 1'b1;
        end
        else begin
            flit_out_valid <= 1'b0;
        end
    end

endmodule
